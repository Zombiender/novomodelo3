# NÃO versione o .env. Variáveis VITE_* ficam embutidas no app final.
# Tudo abaixo é opcional: Gemini e Spotify também podem ser configurados dentro do app,
# na aba Configurações (engrenagem no dock da Home), e o que for salvo lá tem prioridade.
VITE_NOME_ASSISTENTE=
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.8-flash
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REFRESH_TOKEN=
VITE_CHAVE_PIX=
